# Python build / cache artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Jupyter scratch
.ipynb_checkpoints/

# OS
.DS_Store

# Everything under data/ is local output, not source: the SQLite database
# and the BGG CSV. It changes on every run and is reproducible by scraping,
# so the repository carries code only. A fresh clone has no catalog: run
# `tablero update` to scrape one.
/data/

# pytest
.pytest_cache/


# Android / Gradle
android/.gradle/
android/.kotlin/
android/local.properties
# Release signing: the keystore and its passwords never enter version control.
android/release.jks
android/keystore.properties
